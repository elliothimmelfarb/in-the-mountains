# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
.playwright-mcp/
*.local.png

# audio oracle scratch render (regen: npx tsx scripts/audio-render.ts)
docs/progress/_audio-latest/

# generated asset-gallery manifest (regen: node scripts/gallery.mjs)
public/_dev/assets.json

# Claude Code: share project settings (.claude/settings.json), never the machine-local file
.claude/settings.local.json
